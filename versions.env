# =============================================================================
# DEVOPS CLUSTER - CENTRAL VERSION MANIFEST
# =============================================================================
# This is the SINGLE SOURCE OF TRUTH for all image and tool versions.
# ALL Dockerfiles and K8s manifests derive versions from here.
#
# COMPATIBILITY TABLE (last validated: 2026-05-09)
#
#  jenkins/jenkins:lts-jdk21            -> Java 21 (class file 65.0)
#  jenkins/inbound-agent:3301.v4363ddcca_4e7-1 -> Java 21 (must match controller)
#  sonarqube:10.5-community             -> requires postgres 13-16
#  sonatype/nexus3:3.68.0               -> Java 11+ bundled internally
#  postgres:15.7                        -> used by sonarqube (13-16 supported)
#  google/cloud-sdk:502.0.0-alpine      -> gcloud 502.x
#
# UPGRADE PROCEDURE:
#   1. Update the version below
#   2. Run: .\scripts\build-agents.ps1 -AgentVersion <new-semver>
#   3. Blue/Green: .\scripts\upgrade-tool.ps1 -Tool <name> -NewVersion <tag>
#   4. Validate with: .\scripts\upgrade-tool.ps1 -Tool <name> -Action verify
# =============================================================================

# ─── PLATFORM IMAGES ─────────────────────────────────────────────────────────
# Jenkins controller - LTS on Java 21
JENKINS_IMAGE=jenkins/jenkins
JENKINS_TAG=2.555-jdk21

# Jenkins JNLP inbound agent base - MUST match Java version of controller
# java 21 = class file 65.0 | java 17 = class file 61.0
JENKINS_AGENT_BASE_IMAGE=jenkins/inbound-agent
JENKINS_AGENT_BASE_TAG=3301.v4363ddcca_4e7-1

# Nexus Repository Manager
NEXUS_IMAGE=sonatype/nexus3
NEXUS_TAG=3.68.0

# SonarQube - Community Edition
SONARQUBE_IMAGE=sonarqube
SONARQUBE_TAG=10.5.1-community

# PostgreSQL - backend for SonarQube (supported: 13-16)
POSTGRES_IMAGE=postgres
POSTGRES_TAG=15.7

# GCloud backup sidecar
GCLOUD_SDK_IMAGE=google/cloud-sdk
GCLOUD_SDK_TAG=502.0.0-alpine

# Busybox init containers
BUSYBOX_IMAGE=busybox
BUSYBOX_TAG=1.36.1

# Ubuntu base for tools-builder stage
UBUNTU_BUILDER_IMAGE=ubuntu
UBUNTU_BUILDER_TAG=22.04

# ─── TOOL VERSIONS INSIDE AGENTS ─────────────────────────────────────────────
# Terraform
TERRAFORM_VERSION=1.9.8

# AWS CLI v2 (no pinning via URL; latest v2 installed - pin via hash if needed)
# Pinned: 2.27.x (latest at time of validation)
AWS_CLI_VERSION=2.27.0

# Sonar Scanner CLI (must be compatible with SonarQube server version)
# SonarQube 10.x -> Scanner CLI 5.x
SONAR_SCANNER_VERSION=6.2.1.4610

# gcloud SDK (matches backup sidecar; installed via apt repo - pinned by repo pin)
GCLOUD_SDK_APT_VERSION=502.0.0

# Trivy vulnerability scanner
TRIVY_VERSION=0.61.0

# Docker CLI (for docker-in-docker builds; matches Docker Engine API)
DOCKER_CLI_VERSION=28.1.0

# ─── LANGUAGE RUNTIMES ───────────────────────────────────────────────────────
# Python agent
PYTHON_VERSION=3.12

# Maven agent - JDK + Maven
MAVEN_JDK_VERSION=21
MAVEN_VERSION=3.9.9

# Node.js agent
NODEJS_MAJOR_VERSION=22

# .NET agent
DOTNET_SDK_VERSION=8.0

# ─── CLUSTER IMAGE VERSION (for agent images in Artifact Registry) ────────────
# Bump this when rebuilding agents. Format: YYYY.MM.N
# Referenced by build-agents.ps1 and jenkins.yaml cloud templates
AGENT_IMAGE_VERSION=2026.05.1
