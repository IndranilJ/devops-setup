# =============================================================================
# Jenkins .NET Agent
# Versions governed by: /versions.env
#
# Base:         jenkins/inbound-agent:3301.v4363ddcca_4e7-1  (Java 21)
# Controller:   jenkins/jenkins:2.504.1-lts-jdk21            (Java 21)
# .NET SDK:     8.0 LTS (via Microsoft apt repo)
# Terraform:    1.9.8
# Sonar:        6.2.1.4610
# Trivy:        0.61.0
# Docker CLI:   28.1.0
# gcloud SDK:   502.0.0
# =============================================================================

# =====================================================
# Stage 1: Tools Builder
# =====================================================
ARG UBUNTU_BUILDER_TAG=22.04
FROM ubuntu:${UBUNTU_BUILDER_TAG} AS tools-builder

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip tar ca-certificates && rm -rf /var/lib/apt/lists/*

# Terraform - pinned version
ARG TERRAFORM_VERSION=1.9.8
RUN curl -fsSL https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip -o /tmp/terraform.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin && rm /tmp/terraform.zip

# AWS CLI v2 - pinned version
ARG AWS_CLI_VERSION=2.27.0
RUN curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip -o /tmp/aws.zip \
    && unzip /tmp/aws.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/aws.zip

# Sonar Scanner CLI - pinned version (compatible with SonarQube 10.x)
ARG SONAR_VERSION=6.2.1.4610
RUN curl -fsSL https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_VERSION}-linux-x64.zip -o /tmp/sonar.zip \
    && unzip /tmp/sonar.zip -d /opt && mv /opt/sonar-scanner-* /opt/sonar-scanner \
    && ln -s /opt/sonar-scanner/bin/sonar-scanner /usr/local/bin/sonar-scanner && rm /tmp/sonar.zip

# =====================================================
# Stage 2: Jenkins Runtime
# Java 21 base - MUST match jenkins/jenkins controller tag
# =====================================================
ARG JENKINS_AGENT_BASE_TAG=3301.v4363ddcca_4e7-1
FROM jenkins/inbound-agent:${JENKINS_AGENT_BASE_TAG}

USER root

# Agent metadata
ARG AGENT_IMAGE_VERSION=2026.05.1
ENV AGENT_TYPE="dotnet"
ENV AGENT_IMAGE_VERSION="${AGENT_IMAGE_VERSION}"
ENV PATH="/usr/local/aws-cli/v2/current/bin:/opt/sonar-scanner/bin:${PATH}"

# 1. Base Essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip ca-certificates gnupg lsb-release wget apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# 2. Azure CLI
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash && rm -rf /var/lib/apt/lists/*

# 3. Google Cloud SDK - pinned via apt version
ARG GCLOUD_VERSION=502.0.0
RUN mkdir -p /usr/share/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] http://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update && apt-get install -y google-cloud-sdk=${GCLOUD_VERSION}-0 \
    && rm -rf /var/lib/apt/lists/*

# 4. Trivy - pinned version
ARG TRIVY_VERSION=0.61.0
RUN curl -sL https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.deb -o /tmp/trivy.deb \
    && dpkg -i /tmp/trivy.deb && rm /tmp/trivy.deb

# 5. Docker CLI - pinned version
ARG DOCKER_CLI_VERSION=28.1.0
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y docker-ce-cli=5:${DOCKER_CLI_VERSION}-1~ubuntu.22.04~jammy \
    && rm -rf /var/lib/apt/lists/*

# 6. .NET SDK - pinned version via Microsoft apt repo
ARG DOTNET_SDK_VERSION=8.0
RUN wget https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb && rm packages-microsoft-prod.deb \
    && apt-get update && apt-get install -y dotnet-sdk-${DOTNET_SDK_VERSION} \
    && rm -rf /var/lib/apt/lists/*

# 7. Copy Tools from Builder
COPY --from=tools-builder /usr/local/bin/terraform /usr/local/bin/terraform
COPY --from=tools-builder /usr/local/bin/aws /usr/local/bin/aws
COPY --from=tools-builder /usr/local/aws-cli /usr/local/aws-cli
COPY --from=tools-builder /opt/sonar-scanner /opt/sonar-scanner
COPY --from=tools-builder /usr/local/bin/sonar-scanner /usr/local/bin/sonar-scanner

# 8. Runtime setup
RUN groupadd -f docker && usermod -aG docker jenkins
COPY agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER jenkins
ENTRYPOINT ["/entrypoint.sh"]